# Settings for docker-compose.yml. Copy to .env beside it and fill in.
# (Application settings such as mail and PayMongo go in backend/.env.)

# The domain this system is served on, pointed at this server.
DOMAIN=firm.example.ph
APP_URL=https://firm.example.ph
SANCTUM_STATEFUL_DOMAINS=firm.example.ph

# Strong, different passwords. The superuser is used only for administration
# and backups; the app connects as ph_legal.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Encrypts every backup. Store a copy away from the server (a password
# manager, a sealed envelope in the office safe): lose it and the backups
# cannot be restored.
BACKUP_PASSPHRASE=
# Local time of the nightly backup, days kept on this server.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone, e.g. b2:firm-backups/lexph. Configure the remote
# with "rclone config" and put rclone.conf in backend/docker/backup/config/.
RCLONE_REMOTE=

# Live notifications (WebSockets). Any random strings; keep the secret secret.
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Monitoring. Point an uptime monitor at https://<DOMAIN>/api/health.
OPS_ALERT_EMAIL=
HEALTH_TOKEN=
SENTRY_LARAVEL_DSN=

# Trying it out on your own computer: DOMAIN=localhost, APP_URL=https://localhost,
# SANCTUM_STATEFUL_DOMAINS=localhost and HSTS_MAX_AGE=0, then accept the
# browser's certificate warning (Caddy's local certificate).
# HSTS_MAX_AGE=0
# HTTP_PORT=80
# HTTPS_PORT=443
