APP_NAME="Lex PH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The React SPA (used in email links). In development Vite proxies /api to APP_URL.
FRONTEND_URL=http://localhost:5173
# Origins allowed to use cookie-based SPA authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 is the supported production database (trust-ledger
# constraints and triggers are PostgreSQL-specific). SQLite works for
# local development and is what the test suite uses.
#
# Connect as an ordinary role that owns the database, NOT a superuser:
# superusers bypass the row-level security that isolates firms.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ph_legal
DB_USERNAME=ph_legal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# reverb for live notifications (docker-compose.yml sets it); log or null
# makes the bell poll every minute instead.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# OCR and the assistant take minutes per job; send them to their own queue
# (and worker) so deadline reminders never wait behind them. Docker uses
# redis-heavy; "database" runs them on the same worker as everything else.
# QUEUE_HEAVY_CONNECTION=redis-heavy

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Uploaded matter files. Any private disk from config/filesystems.php
# (e.g. an S3 bucket without public access). Never the `public` disk.
MATTER_FILES_DISK=local

# ClamAV virus scanning of uploads (docker-compose.yml runs clamd).
# CLAMAV_FAIL_OPEN=true stores files unscanned when the scanner is down;
# the default refuses uploads instead.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false

# OCR of scanned images and image-only PDFs (needs tesseract-ocr with the
# "fil" language data and poppler-utils; the Docker image includes them).
# These jobs run on the heavy queue; keep its retry_after above 600 s
# (REDIS_HEAVY_QUEUE_RETRY_AFTER, default 900).
OCR_ENABLED=false
OCR_LANGUAGES=eng+fil
OCR_MAX_PAGES=30

# PayMongo (https://paymongo.com) online payment of invoices: cards, GCash,
# Maya, QR Ph. Leave the secret key empty to turn online payment off.
# Register a webhook for https://<your-domain>/api/webhooks/paymongo with the
# event checkout_session.payment.paid and paste its secret below.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph

# Bulk document import (Firm Settings > Import data): the largest ZIP, its
# most files, and the most it may unpack to.
DOCUMENT_IMPORT_MAX_MB=2048
DOCUMENT_IMPORT_MAX_FILES=5000
DOCUMENT_IMPORT_MAX_UNPACKED_MB=10240

# Electronic filing: the court's size limit for one e-filed PDF, in MB.
EFILING_MAX_MB=25

# Electronic invoicing (BIR EIS). "record" keeps each e-invoice on file and sends
# nothing (until you choose an accredited provider). "http" posts each one as
# JSON to the provider's HTTPS endpoint with a bearer token, an HMAC-SHA256
# signature of the body (X-Signature) and an Idempotency-Key.
EINVOICE_DRIVER=record
EINVOICE_ENDPOINT=
EINVOICE_TOKEN=
EINVOICE_SECRET=
# Days after the invoice by which an e-invoice must reach the BIR.
EINVOICE_DEADLINE_DAYS=3

# Email to matter: each matter gets an address like files+m-2026-0019.k2j4h5g6f7@<domain>.
# Route the domain's mail to your inbound provider (SendGrid Inbound Parse with
# "POST the raw, full MIME message", or a Mailgun route to a .../mime URL) and
# point it at https://inbound:<INBOUND_EMAIL_SECRET>@<your-domain>/api/webhooks/inbound-email.
# INBOUND_EMAIL_AUTHSERV_ID is the server name your provider writes in its
# Authentication-Results headers; only its SPF/DKIM/DMARC verdicts are trusted.
# Leave the address empty to allow .eml uploads only.
INBOUND_EMAIL_ADDRESS=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_AUTHSERV_ID=

# Semaphore (https://semaphore.co) SMS for urgent deadline alerts.
# Leave the key empty to log messages instead of sending them.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Operations (docker-compose.yml sets these from the top-level .env).
# Alerts for failed jobs, failing health checks and trust reconciliation.
OPS_ALERT_EMAIL=
# Bearer token that makes /api/health return each check's detail.
HEALTH_TOKEN=
# Check the queue workers' and scheduler's heartbeats (true where they run).
HEALTH_EXPECT_WORKERS=false
# Status file written by the backup container.
BACKUP_STATUS_FILE=
# Error tracking (https://sentry.io). Empty: off. Request bodies and user
# details are never sent.
SENTRY_LARAVEL_DSN=
# Proxies allowed to set X-Forwarded-For/-Proto (comma-separated IPs/CIDRs).
TRUSTED_PROXIES=
# true when served over HTTPS.
SESSION_SECURE_COOKIE=false
